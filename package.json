{
  "name": "@grain/binaryen.ml",
  "version": "0.37.0",
  "description": "OCaml bindings for Binaryen.",
  "author": "Oscar Spencer <oscar@grain-lang.org>",
  "license": "Apache-2.0",
  "installConfig": {
    "pnp": false
  },
  "dependencies": {
    "ocaml": ">= 4.13.0 < 5.4.0",
    "@grain/libbinaryen": "*",
    "@opam/dune": ">= 3.0.0",
    "@opam/dune-configurator": ">= 3.0.0"
  },
  "devDependencies": {
    "@opam/js_of_ocaml-compiler": ">= 6.4.0 < 7.0.0",
    "@opam/ocamlformat": "0.29.0",
    "@opam/ocaml-lsp-server": ">= 1.9.1 < 2.0.0"
  },
  "resolutions": {
    "@opam/ocp-indent": "1.9.0",
    "@opam/ocamlfind": "1.9.8",
    "@grain/libbinaryen": "git+https://github.com/grain-lang/libbinaryen.git#d5a652d30d5098ae1db145a9c427e8a81de59426"
  },
  "esy": {
    "build": "dune build -p binaryen"
  },
  "scripts": {
    "test": "esy b dune runtest --display=short",
    "format": "dune build @fmt --auto-promote"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "binaryen",
    "ocaml"
  ]
}
